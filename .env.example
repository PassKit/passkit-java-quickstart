# Copy this file to .env and fill in your own values. Never commit .env or PEM files.
PASSKIT_GRPC_HOST=grpc.pub1.passkit.io
PASSKIT_GRPC_PORT=443
PASSKIT_CERTIFICATE=src/main/resources/credentials/certificate.pem
PASSKIT_KEY=src/main/resources/credentials/key-java.pem
PASSKIT_CA_CHAIN=src/main/resources/credentials/ca-chain.pem
PASSKIT_KEY_PASSWORD=
PASSKIT_BASE_EMAIL=you@example.com
PASSKIT_VIP_EMAIL=you@example.com
PASSKIT_APPLE_CERTIFICATE_ID=
PASSKIT_POOL_SIZE=4
PASSKIT_CLEANUP_DELAY_SECONDS=0
